# ============================================================
# 复制为 .env 后填写。.env 被 .gitignore 忽略，绝不入库。
# 程序只读进程环境变量，不自动加载本文件。
# ============================================================

# ---------- 模型（OpenAI 兼容协议）----------
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-replace-with-your-own-key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# ---------- 应用 ----------
APP_DB_PATH=data/agent.db
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ---------- Agent 上限 ----------
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_STEPS=12
AGENT_MAX_LLM_RETRIES=2
